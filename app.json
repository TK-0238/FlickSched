{
  "expo": {
    "name": "サクヨテ",
    "slug": "sakuyote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sakuyote",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sakuyote.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "カレンダーに予定を追加するためにアクセスが必要です",
        "NSCalendarsFullAccessUsageDescription": "カレンダーに予定を追加するためにアクセスが必要です"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.sakuyote.app",
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "カレンダーに予定を追加するためにアクセスが必要です"
        }
      ],
      "expo-web-browser"
    ]
  }
}
